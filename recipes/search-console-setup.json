{
  "id": "search-console-setup",
  "version": 1,
  "name": "Google Search Console 설정",
  "description": "Search Console에 속성을 추가하고 소유권을 확인한다.",
  "type": "setup",
  "match": {
    "hosts": ["search.google.com"],
    "urlIncludes": ["/search-console/"]
